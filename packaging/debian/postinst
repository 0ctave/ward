#!/bin/sh
# ward postinst: state directories, byte-compile, desktop caches, resident engine.
# PAM is never touched here — the user runs `sudo ward pam enable` (or `ward setup`).
set -e
if [ "$1" = configure ]; then
  mkdir -p /etc/ward/models; chmod 700 /etc/ward/models
  [ -e /var/log/ward.log ] || { touch /var/log/ward.log; chmod 640 /var/log/ward.log; chgrp adm /var/log/ward.log 2>/dev/null || true; }
  /usr/bin/python3 -m compileall -q /usr/lib/ward >/dev/null 2>&1 || true
  command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q /usr/share/icons/hicolor || true
  command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications || true
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null; then
    systemctl daemon-reload || true
    # like install.sh: on by default on first install; a `ward daemon disable` survives upgrades
    if [ -z "$2" ]; then
      systemctl enable --now ward.service || echo "ward: resident engine did not start — unlock still works in-process (journalctl -u ward)"
    elif systemctl is-enabled --quiet ward.service; then
      systemctl restart ward.service || true
    fi
  fi
  [ -n "$2" ] || echo "ward installed. Next: ward doctor, then sudo ward setup (wires PAM; nothing was changed in /etc/pam.d)"
fi
# Inert '#'-comment under dpkg-deb (build-deb.sh); the dpkg-buildpackage/debhelper path
# (./debian) substitutes any generated snippets here. dh_installsystemd is suppressed in
# debian/rules, so the enable logic above stays the single cross-distro implementation.
#DEBHELPER#
exit 0
