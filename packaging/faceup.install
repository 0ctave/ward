# pacman hooks for faceup. PAM is never edited here: run `sudo faceup setup`.
post_install() {
  [ -e /var/log/faceup.log ] || { touch /var/log/faceup.log; chmod 640 /var/log/faceup.log; chgrp wheel /var/log/faceup.log 2>/dev/null; }
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable --now faceup.service || echo "faceup: resident engine did not start — unlock still works in-process"
  fi
  echo "faceup installed. Next: faceup doctor, then sudo faceup setup (nothing was changed in /etc/pam.d)"
}
post_upgrade() {
  [ -d /run/systemd/system ] || return 0
  systemctl daemon-reload
  if systemctl is-enabled --quiet faceup.service; then systemctl restart faceup.service || true; fi
}
pre_remove() {
  # pacman cannot abort here: warn loudly instead (a dangling line falls through, but fix it)
  refs=$(grep -lE 'faceup-auth|pam_faceup\.so' /etc/pam.d/* 2>/dev/null | grep -v '\.faceup-bak$')
  [ -z "$refs" ] || echo "WARNING: faceup is still referenced in: $refs — remove those lines (sudo faceup pam disable before removing next time)" >&2
  [ -d /run/systemd/system ] && systemctl disable --now faceup.service 2>/dev/null
  return 0
}
