# Arch Linux. Offline build from this checkout:
#   cd packaging && makepkg -si
# Same layout as packaging/stage.sh under /usr. Never edits PAM: run `sudo faceup setup`.
pkgname=faceup
pkgver=0.3.0
pkgrel=1
pkgdesc="Reliable face unlock for login, sudo and polkit"
arch=('x86_64' 'aarch64')
url="https://github.com/<you>/faceup"
license=('MIT')
depends=('python' 'python-opencv' 'python-numpy' 'pam')
makedepends=('gcc')
optdepends=('python-dlib: dlib recogniser (AUR; ArcFace works without it)'
            'python-gobject: GTK windows'
            'gtk4: GTK windows'
            'libadwaita: GTK windows'
            'polkit: the faceup app launcher')
install=faceup.install
options=('!debug' '!strip')
# the repo itself is the source: no download
_src=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

package() {
  FACEUP_REQUIRE_PAM_MODULE=1 LDFLAGS="$LDFLAGS" "$_src/packaging/stage.sh" "$pkgdir" /usr /usr/lib/systemd/system
  python -m compileall -q -d /usr/lib/faceup "$pkgdir/usr/lib/faceup" >/dev/null
  install -Dm644 "$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -dm700 "$pkgdir/etc/faceup/models"
}
