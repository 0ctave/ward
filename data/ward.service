[Unit]
Description=ward resident face engine (keeps the models loaded for fast face unlock)
Documentation=file:///usr/local/lib/ward/README.md
After=systemd-udevd.service

[Service]
# READY=1 once the models are warm; WATCHDOG=1 every WatchdogSec/2 unless an attempt is wedged
# (ward/daemon.py, stdlib sd_notify). A missed ping = a kill + Restart=on-failure.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/ward daemon run
Restart=on-failure
RestartSec=2
TimeoutStartSec=90
WatchdogSec=30
Environment=PYTHONUNBUFFERED=1

# --- sandbox -----------------------------------------------------------------------------------
# Needs: read/write /etc/ward (store, learning) and /var/log/ward.log, /run/ward (socket),
# open /dev/video* and do UVC XU ioctls on them (IR emitter), read sysfs (ALS, USB ids).
# Root-owned files only and nothing spawned as another user (notifications run in the PAM client),
# so no capability at all is needed.
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-video4linux rw
# no /dev/dri: recognition.accel=opencl finds no OpenCL device here and cv2.dnn runs on the CPU
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/etc/ward /var/log
RuntimeDirectory=ward
RuntimeDirectoryMode=0700
UMask=0077
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# verified: numpy, OpenCV (YuNet/cv2.dnn, CLAHE) and dlib (HOG, ResNet embedding) run under W^X
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RemoveIPC=yes
KeyringMode=private
# measured RSS: ~195 MB warm, flat at ~203 MB over 200 attempts (dlib). ArcFace r50 is a 281 MB ONNX
# and a reload briefly holds the file buffer + the weights on top: 512M would OOM-kill that reload.
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
