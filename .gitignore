__pycache__/
*.pyc
build/
dist/
*.egg-info/

# Packaging build byproducts (debuild -S / dpkg-buildpackage / rpmbuild / .copr/Makefile).
# The source package and its artifacts are generated, not source — never commit them.
/debian/files
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/*.substvars
/debian/*.debhelper.log
/debian/ward/
/rpmbuild/
*.deb
*.dsc
*.buildinfo
*.changes
*.src.rpm

# Private local extension (duress failsafe etc.) — never committed or distributed
extensions/

# --- Personal / biometric data: must NEVER be committed ------------------------
# Enrolled face embeddings, calibration, learned models (the store lives in /etc/ward,
# but guard against a copy landing in the tree):
*.cred
models/*.json
*_models.json
calib*.json
# Attempt log and any copy of it:
*.log
ward.log*
# Recorded camera frames / lab captures / replay corpora / benchmark dumps:
samples/
samples_*/
frames/
lab/
*.ndjson
# Datasets (LFW, CelebA-Spoof, CASIA-SURF, WMCA): research-only, never bundle:
lfw/
CelebA_Spoof/
CASIA-SURF/
WMCA/
*_dataset/
# NOTE: ward/models/*.onnx (YuNet, MiniFASNet) and data/*.svg ARE tracked on purpose —
# they are redistributable shipped models and the app icons, not personal data.
